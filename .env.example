# Railway sets PORT automatically
PORT=8080

# Public URL after deploy (set manually if RAILWAY_PUBLIC_DOMAIN missing)
# PUBLIC_BASE_URL=https://weppy-mcp-production.up.railway.app

# Optional: protect MCP endpoints (/sse /message /mcp)
MCP_AUTH_TOKEN=change-me-long-random

# WEPPY internal HTTP bridge (Studio plugin + dashboard)
HTTP_HOST=127.0.0.1
HTTP_PORT=3002

# Supergateway internal port
SUPERGATEWAY_PORT=8787

LOG_LEVEL=info
DASHBOARD_AUTO_OPEN=false
SKIP_PLUGIN_INSTALL=true
WEPPY_MCP_DETACHED_LIFECYCLE=true
